			"text": "小结",
			"originalText": "小结",
			"fontSize": 48,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "bA9",
