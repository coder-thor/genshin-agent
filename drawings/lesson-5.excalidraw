			"updated": 1793608487528,
			"link": null,
			"locked": false,
			"text": "while (true) {\n  const answer = await callModel(messages, tools);\n  messages.push(answer);\n  if (!answer.tool_calls?.length) return answer;\n  for (const call of answer.tool_calls) {\n    const result = await runTool(...);\n    messages.push({ role: \"tool\", ... });\n  }\n}",
			"originalText": "while (true) {\n  const answer = await callModel(messages, tools);\n  messages.push(answer);\n  if (!answer.tool_calls?.length) return answer;\n  for (const call of answer.tool_calls) {\n    const result = await runTool(...);\n    messages.push({ role: \"tool\", ... });\n  }\n}",
