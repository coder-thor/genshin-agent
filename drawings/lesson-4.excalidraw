		{
			"id": "ec71S5FV",
			"type": "text",
			"x": 90,
			"y": 12465,
			"width": 954.2717895507812,
			"height": 55,
			"angle": 0,
			"strokeColor": "#002fa7",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": "ofDyuVnPZCF5LlefufOA",
			"roundness": null,
			"seed": 1405723659,
			"version": 2,
